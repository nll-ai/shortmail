# Convex (set by `npx convex dev` / deploy; see scripts/vercel-build.sh)
# NEXT_PUBLIC_CONVEX_URL is the .cloud base URL. The public HTTP actions
# (config/send/collect) live on the .site twin — derived by swapping
# ".convex.cloud" for ".convex.site". CONVEX_URL is the optional server-side
# alias used by the `convex/nextjs` helpers; server components here read
# NEXT_PUBLIC_CONVEX_URL directly.
NEXT_PUBLIC_CONVEX_URL=
# CONVEX_URL=

# WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=            # >= 32 chars, distinct per environment
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Bootstrap: first verified login with this email becomes super_admin
SUPER_ADMIN_EMAIL=

# Resend (Convex production dashboard env, used by the email action).
# Do not copy this onto Convex preview deployments. Previews block mail
# unless SHORTMAIL_PREVIEW_RESEND_API_KEY is set, and then only to
# SHORTMAIL_EMAIL_ALLOWLIST. See docs/preview-deployments.md.
RESEND_API_KEY=

# Preview builds (Vercel Preview only). Production must not set SHORTMAIL_PREVIEW.
# SHORTMAIL_PREVIEW=1
# SHORTMAIL_PUBLIC_ORIGIN=https://shortmail.nonlinearlabs.ai
# SHORTMAIL_EMAIL_ALLOWLIST=
# SHORTMAIL_PREVIEW_RESEND_API_KEY=
# SHORTMAIL_PREVIEW_EMAIL_SINK=
# SHORTMAIL_PREVIEW_HYDRATE=on-create
# SHORTMAIL_PREVIEW_SCRUB=
